{
  "name": "usb-writer",
  "version": "1.0.0",
  "description": "Universal, high-speed bootable ISO/IMG USB writer for Windows, macOS, and Linux",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --dir",
    "build:electron": "tsc && vite build",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "usb-writer",
    "rufus",
    "etcher",
    "bootable-usb",
    "iso-flasher",
    "electron",
    "cross-platform"
  ],
  "author": "RitualDev Lab <developer@ritualdev.com>",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
